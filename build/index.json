{
  "data": [
    {
      "id": "dimension",
      "label": "Dimensions",
      "elements": [
        {
          "id": "dimID",
          "label": "Employee",
          "type": "DIMENSION",
          "options": { "min": 1, "max": 1 }
        }
      ]
    },
    {
      "id": "metric",
      "label": "Metrics",
      "elements": [
        {
          "id": "metricID",
          "label": "Competency Metrics",
          "type": "METRIC",
          "options": { "min": 3, "max": 35 }
        }
      ]
    }
  ],
  "style": [
    {
      "id": "chartOptions",
      "label": "Chart Options",
      "elements": [
        { "type": "INTERVAL", "id": "width", "label": "Line Width", "defaultValue": 1, "min": 1, "max": 10, "step": 1 },
        { "type": "CHECKBOX", "id": "fill", "label": "Fill Area", "defaultValue": true },
        { "type": "OPACITY", "id": "opacity", "label": "Fill Opacity", "defaultValue": 0.1 },
        { "type": "TEXT", "id": "fontFamily", "label": "Font Family", "defaultValue": "Arial" },
        { "type": "INTERVAL", "id": "fontSize", "label": "Font Size", "defaultValue": 12, "min": 8, "max": 32, "step": 1 }
      ]
    },
    {
      "id": "axisOptions",
      "label": "Axis Options",
      "elements": [
        { "type": "INTERVAL", "id": "ymin", "label": "Y-Axis Minimum", "defaultValue": 0, "min": 0, "max": 10, "step": 0.5 },
        { "type": "INTERVAL", "id": "ymax", "label": "Y-Axis Maximum", "defaultValue": 5, "min": 1, "max": 10, "step": 0.5 },
        { "type": "INTERVAL", "id": "yticks", "label": "Y-Axis Ticks Step", "defaultValue": 0.5, "min": 0.1, "max": 2, "step": 0.1 },
        { "type": "CHECKBOX", "id": "ylabels", "label": "Hide Y-Axis Labels", "defaultValue": false },
        { "type": "CHECKBOX", "id": "ylines", "label": "Hide Y-Axis Lines", "defaultValue": false }
      ]
    },
    {
      "id": "tooltipOptions",
      "label": "Tooltip Options",
      "elements": [
        { "type": "CHECKBOX", "id": "tooltips", "label": "Hide Tooltips", "defaultValue": false }
      ]
    },
    {
      "id": "legendOptions",
